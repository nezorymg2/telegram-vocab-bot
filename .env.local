# Локальный файл для тестирования
# Создайте тестового бота через @BotFather и вставьте токен сюда
BOT_TOKEN=YOUR_TEST_BOT_TOKEN_HERE
DATABASE_URL=file:./dev.db

# Инструкция:
# 1. Идите к @BotFather в Telegram
# 2. Отправьте /newbot
# 3. Назовите бота (например "My Test Vocab Bot")
# 4. Дайте username (например "my_test_vocab_bot")
# 5. Скопируйте токен и замените YOUR_TEST_BOT_TOKEN_HERE